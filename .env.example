# Admin panel
ADMIN_PASSWORD=admin123
ADMIN_SECRET=change-this-to-a-random-secret-key

# Supabase (server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
